# --- LLM: any OpenAI-compatible API serving an open model -----------------
# Default is Groq's free tier (no credit card): https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Other free options (same three variables):
#   OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1  LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Database -------------------------------------------------------------
# On Render this is injected for you. Locally, either set DATABASE_URL ...
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/financial_agent
# ... or the individual variables below (what docker-compose uses):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financial_agent
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=postgres
DB_READONLY_USER=agent_readonly
DB_READONLY_PASSWORD=change_me_in_env

# --- Optional -------------------------------------------------------------
# CORPUS_PATH=data/corpus.jsonl     # prebuilt filings index (see README)
# ENABLE_RERANKER=false             # +~100 MB RAM; better passage ordering
# RATE_LIMIT_PER_MINUTE=8           # per IP; 0 disables
